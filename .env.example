# --- Aqua source chain (mainnet only; Aqua has no testnet) ---
# Chain must be one of: 1 10 56 100 130 137 146 324 8453 42161 43114 59144
CHAIN_ID=1
RPC_URL=
# Aqua launched 2025-11-17. See MAINNET_LAUNCH_BLOCK in src/config.ts.
START_BLOCK=
LOG_CHUNK_SIZE=2000
CONFIRMATIONS=2

# --- Arkiv (Braga testnet) ---
# Defaults resolve from the SDK's braga chain export if left blank.
ARKIV_RPC_URL=https://braga.hoodi.arkiv.network/rpc
ARKIV_PRIVATE_KEY=
ARKIV_CHAIN_ID=60138453102

# --- Heartbeat: refresh must be well under half the expiry ---
HEARTBEAT_EXPIRY_SECONDS=300
HEARTBEAT_REFRESH_SECONDS=60

# --- Local fork testing ---
ANVIL_RPC_URL=http://127.0.0.1:8545
